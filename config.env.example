# Copier ce fichier en config.env et remplir les valeurs

# Django
SECRET_KEY=changez-moi-avec-une-cle-tres-longue-et-aleatoire
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com

# PostgreSQL
POSTGRES_DB=traitement_n8n
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Port exposé (défaut 1212)
APP_PORT=1212

# IA — Gemini (obtenir clé sur aistudio.google.com)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-1.5-flash

# IA — NVIDIA NIM (optionnel)
NVIDIA_API_KEY=
NVIDIA_MODEL_DEFAULT=mistralai/mixtral-8x7b-instruct-v0.1

# Dossiers SMB (optionnel — laisser vide si pas de partage réseau)
# DOSSIER_VERSIONS_ASTEN=/mnt/asten/Cegid/AstenProd/ReferentielPrecom/Backup
# DOSSIER_FACTURES_SAGE=smb://10.0.70.150/automate-ic/ARCHIVES
