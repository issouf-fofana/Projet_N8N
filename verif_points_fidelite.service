[Unit]
Description=Vérification des points de fidélité articles POS
After=network.target

[Service]
Type=oneshot
User=ifofana
WorkingDirectory=/opt/Projet_N8N/Entree_journal
ExecStart=/opt/Projet_N8N/venv/bin/python3 /opt/Projet_N8N/Entree_journal/verif_points.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=verif-points-fidelite

[Install]
WantedBy=multi-user.target
