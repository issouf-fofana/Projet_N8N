# Configuration des chemins des dossiers d'import
# Modifiez les chemins ci-dessous selon vos besoins
# Les chemins peuvent être :
#   - Relatifs à MEDIA_ROOT (par défaut)
#   - Absolus (commençant par /)
#   - Réseau UNC/Samba (commençant par // ou \\)

# Chemin de base pour les médias (par défaut: media/)
MEDIA_ROOT=media

# Chemins des dossiers d'import (relatifs à MEDIA_ROOT par défaut)
DOSSIER_COMMANDES_ASTEN=commande_asten
DOSSIER_COMMANDES_CYRUS=commande_cyrus
DOSSIER_COMMANDES_GPV=commande_gpv
DOSSIER_COMMANDES_LEGEND=commande_legend
DOSSIER_BR_ASTEN=br_asten
DOSSIER_BR_IC=br_ic

# Factures Sage (CSV) - chemins relatifs à MEDIA_ROOT par défaut
DOSSIER_FACTURES_SAGE=/mnt/automate-ic/ARCHIVES
FACTURES_SAGE_PREFIX=SAGE-I-SP_

# Versions Asten (backups journaliers prdP2A)
DOSSIER_VERSIONS_ASTEN=/mnt/asten/Cegid/AstenProd/ReferentielPrecom/Backup

# Factures Asten
DOSSIER_FACTURES_ASTEN=facture_asten
DOSSIER_FACTURES_ASTEN_BACKUP=/run/user/1000/gvfs/smb-share:server=10.0.70.218,share=d/Cegid/AstenProd/FacturesAvoirs



# USER POSTGRESQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=youssef59
POSTGRES_DB=traitement_n8n
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Exemple avec chemins absolus (décommentez et modifiez si nécessaire):
# DOSSIER_COMMANDES_ASTEN=/chemin/absolu/vers/commande_asten
# DOSSIER_COMMANDES_CYRUS=/chemin/absolu/vers/commande_cyrus
# DOSSIER_COMMANDES_GPV=/chemin/absolu/vers/commande_gpv
# DOSSIER_COMMANDES_LEGEND=/chemin/absolu/vers/commande_legend
# DOSSIER_BR_ASTEN=/chemin/absolu/vers/br_asten
# DOSSIER_BR_IC=/chemin/absolu/vers/br_ic
# DOSSIER_FACTURES_SAGE=/chemin/absolu/vers/facture_sage

# Exemple avec chemins réseau (UNC/Samba) :
# DOSSIER_COMMANDES_ASTEN=//10.0.70.169/share/fofana/commande_asten
# DOSSIER_COMMANDES_CYRUS=//10.0.70.169/share/fofana/commande_cyrus
# DOSSIER_COMMANDES_GPV=//10.0.70.169/share/fofana/commande_gpv
# DOSSIER_COMMANDES_LEGEND=//10.0.70.169/share/fofana/commande_legend
# DOSSIER_BR_ASTEN=//10.0.70.169/share/fofana/br_asten
# DOSSIER_BR_IC=//10.0.70.169/share/fofana/br_ic
# DOSSIER_FACTURES_SAGE=smb://10.0.70.150/automate-ic/ARCHIVES












































































































































































































































































































































































































































































































































































































































































































































































